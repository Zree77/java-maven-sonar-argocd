pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }
  
  stages {
    stage('Checkout') {
      steps {
        // Automatic SCM checkout runs by default; step left for visibility if needed
        sh 'echo "Checkout completed"'
      }
    }

    stage('Build and Test') {
      steps {
        dir('spring-boot-app') {
          sh 'mvn clean package'
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('sonarqube') {
          dir('spring-boot-app') {
            sh '''
              mvn sonar:sonar \
                -Dsonar.projectKey=my-ec2-project \
                -Dsonar.projectName="Spring Boot App" \
                -Dsonar.host.url=$SONAR_HOST_URL
            '''
          }
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "zree7/spring-boot-app:${BUILD_NUMBER}"
      }
      steps {
        script {
          // Adjust path if Dockerfile is inside spring-boot-app directory
          sh 'docker build -t ${DOCKER_IMAGE} spring-boot-app/'
            
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            dockerImage.push()
            dockerImage.push('latest')
          }
        }
      }
    }

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "java-maven-sonar-argocd"
        GIT_USER_NAME = "Zree77"
      }
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'github',
            usernameVariable: 'GITHUB_USERNAME',
            passwordVariable: 'GITHUB_TOKEN'
          )
        ]) {
          sh '''
            git config user.email "zreeprojects@gmail.com"
            git config user.name "${GIT_USER_NAME}"

            sed -i "s|image: .*|image: zree7/spring-boot-app:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml

            git add spring-boot-app-manifests/deployment.yml
            git commit -m "Update image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

            git push https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          '''
        }
      }
    }
  }
}
